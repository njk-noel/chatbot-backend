# Copy to .env for local use. On Render, add these in the dashboard instead.
# NEVER commit your real .env file.

# --- Webhook verification ---
# Any long random string you invent. Paste the same value in the Meta dashboard.
VERIFY_TOKEN=change_me_to_a_long_random_string

# --- WhatsApp Cloud API ---
# Permanent token from a System User (needs whatsapp_business_messaging permission).
WHATSAPP_TOKEN=
# WhatsApp > API Setup > "Phone number ID" (not the phone number itself).
PHONE_NUMBER_ID=

# --- Instagram DMs ---
# Page Access Token of the Facebook Page linked to your Instagram professional account.
INSTAGRAM_TOKEN=

# --- AI (free tier) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional fallback if Gemini is rate limited. Key from https://console.groq.com/keys
GROQ_API_KEY=

# --- Recommended ---
# Meta App Dashboard > App settings > Basic > App secret. Verifies webhook signatures.
# If Instagram and WhatsApp are on different Meta apps, put both secrets comma-separated.
APP_SECRET=

# --- Optional tuning ---
BUSINESS_NAME=Your Business Name
# Facts the bot may rely on: hours, products, delivery, return policy, contact details.
BUSINESS_INFO=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile
GRAPH_API_VERSION=v25.0
